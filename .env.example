# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ngrok — get your token at https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# Static domain from ngrok dashboard (e.g. your-name.ngrok-free.app)
NGROK_DOMAIN=your-domain.ngrok-free.app

# n8n
N8N_HOST=your-domain.ngrok-free.app
WEBHOOK_URL=https://your-domain.ngrok-free.app/
GENERIC_TIMEZONE=Europe/Kyiv

# PostgreSQL backups (optional — values below are the defaults)
# SCHEDULE format: cron, or @daily / @hourly / @weekly
BACKUP_SCHEDULE=@weekly
BACKUP_KEEP_DAYS=0
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=0

# n8n encryption key — generate with: openssl rand -hex 16
# WARNING: without this key, stored credentials cannot be decrypted.
# Back it up outside this project and never change it.
N8N_ENCRYPTION_KEY=generate_me_with_openssl_rand_hex_16
